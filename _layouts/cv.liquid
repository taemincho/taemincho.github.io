---
layout: default
---
<!--
  Local override of al_folio_core's _layouts/cv.liquid: only addition is the
  <style> block below, widening the narrow left-hand date/location column
  (al_folio_core's _sass/_components.scss hardcodes `.date-column { width:
  75px; }`, too narrow for "City, Country" location strings, which wrap and
  collide with the date badge above them). Keep in sync with the gem if it
  changes.
-->
<style>
  /* al_folio_core's `.date-column` is `text-align: center` (from the
     `text-center` class) wrapping a `table.table-cv` that isn't forced to
     100% width, so the table shrinks/grows to fit its widest row. Long
     "City, Country" location text makes that table wider, and the
     shorter, centered year badge shifts along with it -- looks jagged
     from entry to entry depending on location text length. Force a fixed
     width and left-align both badge and location so the year always
     lands at the same spot regardless of location length. */
  .cv .date-column {
    width: 130px;
    text-align: left;
    margin-left: -12px;
  }
  .cv .date-column table.table-cv {
    width: 100%;
  }
  .cv .date-column table.table-cv td {
    text-align: left;
  }
  .cv .date-column .location {
    font-size: 0.75rem;
    line-height: 1.25;
    margin-top: 0.25rem;
  }
  /* Stray dot + hairline between the badge and location rows: neutralize
     every plausible source (row border, list marker, underline) at once. */
  .cv .date-column table.table-cv,
  .cv .date-column table.table-cv tr,
  .cv .date-column table.table-cv td {
    border: none !important;
    border-collapse: collapse;
  }
  .cv .date-column .badge {
    text-decoration: none;
  }
  .cv ul.list-group,
  .cv li.list-group-item {
    list-style: none;
  }
</style>
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
